{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Excalidraw Desktop",
  "version": "1.0.0",
  "identifier": "com.excalidrawer.desktop",
  "build": {
    "frontendDist": "../excalidraw-app/build",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "yarn workspace excalidraw-app dev:tauri",
    "beforeBuildCommand": "yarn workspace excalidraw-app build:desktop"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Excalidraw Desktop",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "fileAssociations": [
      {
        "ext": ["excalidraw"],
        "name": "Excalidraw drawing",
        "description": "Excalidraw whiteboard drawing",
        "mimeType": "application/vnd.excalidraw+json",
        "role": "Editor"
      }
    ],
    "windows": {
      "nsis": {
        "languages": ["English"],
        "displayLanguageSelector": false,
        "startMenuFolder": "Excalidraw Desktop"
      },
      "webviewInstallMode": {
        "silent": true,
        "type": "downloadBootstrapper"
      }
    }
  }
}
